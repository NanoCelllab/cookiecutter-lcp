# Raw data (track only .gitkeep)
**/images/*
!**/images/.gitkeep

**/illum/*
!**/illum/.gitkeep

# Big binaries
*.tif
*.tiff
*.nd2
*.czi
*.lif
*.npz
*.npy

# Heavy outputs (customize as needed)
workspace/**/SaveImages/
workspace/**/QC_images/
workspace/**/exports/
workspace/**/db/*.sqlite
workspace/**/db/*.db

# Caches / temp
.DS_Store
*.tmp
*.log
__pycache__/
.ipynb_checkpoints/

