# --- Raw data: track only placeholders
**/images/*
**/illum/*
!**/.gitkeep

# --- Big binaries (never commit raw microscopy here)
*.tif
*.tiff
*.nd2
*.czi
*.lif
*.npz
*.npy

# --- Heavy outputs (customize as needed)
workspace/**/SaveImages/
workspace/**/QC_images/
workspace/**/exports/
workspace/**/db/*.sqlite
workspace/**/db/*.db

# --- Deep learning weights/checkpoints
**/*.pt
**/*.pth
**/*.ckpt
**/*.h5
workspace_dl/**/checkpoints/

# --- Environment / IDE
.venv/
venv/
.env
.vscode/
*.code-workspace

# --- OS / caches / temp
.DS_Store
._*
Thumbs.db
*.tmp
*.log
__pycache__/
.ipynb_checkpoints/

